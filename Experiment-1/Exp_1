#Multiplication
print("Multiplication",a*b)

#Division
print("Division",a/b)

#Modulus
print("Modulus",a%b)

#Exponentiation
print("Floor Division",a**b)

#Floor Division
print("Floor Division",a//b)


#Relational Operators

x = 13
y = 33

print(x>y)
print(x<y)
print(x == y)
print(x != y)
print(x >= y)
print(x <= y)



#Logical Operators 

#AND operator
